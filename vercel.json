{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://umbomilk-hr.onrender.com/api/:path*" },
    { "source": "/socket.io/:path*", "destination": "https://umbomilk-hr.onrender.com/socket.io/:path*" },
    { "source": "/health", "destination": "https://umbomilk-hr.onrender.com/health" },
    { "source": "/(.*)", "destination": "/public/$1" }
  ]
}

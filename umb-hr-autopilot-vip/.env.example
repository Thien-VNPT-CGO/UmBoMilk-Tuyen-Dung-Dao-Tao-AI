# --- UMB HR AUTOPILOT VIP (.env.example — KHONG commit file .env that) ---
# Copy sang .env va dien gia tri that. Tuyet doi khong commit secret.
VIP_ENV=dev
VIP_HOST=127.0.0.1
VIP_PORT=8001
VIP_SECRET_KEY=CHANGE-ME-32-CHARS-MINIMUM
VIP_JWT_EXPIRES_MIN=720

# Node Core hien tai (khong sua Core)
NODE_CORE_URL=http://127.0.0.1:3000
NODE_CORE_TIMEOUT_SEC=10

# Service-to-service auth (production bat buoc, khong expose frontend)
VIP_SERVICE_CLIENT_ID=vip-service
VIP_SERVICE_SECRET=CHANGE-ME-SERVICE-SECRET

# Dev login fallback (chi dev; production dung Node Core proxy)
VIP_DEV_ADMIN_USER=admin
# bcrypt hash cua password dev — tao bang: python -c "import bcrypt; print(bcrypt.hashpw(b'pass', bcrypt.gensalt()).decode())"
VIP_DEV_ADMIN_HASH=
VIP_DEV_ROLE=ADMIN

# Database Stage A: Postgres production; SQLite file cho dev
DATABASE_URL=
# vi du Postgres: postgresql+psycopg://user:pass@localhost:5432/umb_vip
VIP_DB_PATH=./data/vip.db

# Redis (tuy chon o PHASE 2; thieu thi DEGRADED + fallback in-memory)
REDIS_URL=
# vi du: redis://127.0.0.1:6379/0

# AI provider (PHASE 8; de trong thi AI=OFF, rule engine van chay)
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# Zalo / Google (doc tu Node Core settings; khong hard-code o day)
ZALO_WEBHOOK_SECRET=
GOOGLE_SHEET_WEBHOOK_SECRET=

# (Khuyến nghị) Đặt Private Key qua UI: Admin -> Cài đặt -> Google Sheet -> Private Key (sẽ tự mã hoá)

RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_GLOBAL_MAX=300

